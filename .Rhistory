import pandas as pd
import numpy as np
# Reconstruindo os dados extraídos do artigo para o Paraná
dados_parana = {
"Município": ["Curitiba", "Londrina", "Maringá", "Ponta Grossa", "Cascavel"] * 5,
"Ano": [2008, 2008, 2008, 2008, 2008, 2009, 2009, 2009, 2009, 2009,
2010, 2010, 2010, 2010, 2010, 2011, 2011, 2011, 2011, 2011,
2012, 2012, 2012, 2012, 2012],
"Sexo": ["Masculino", "Feminino"] * 12 + ["Masculino"],
"Número de Fraturas": [120, 180, 80, 100, 90, 130, 190, 85, 110, 95,
140, 200, 90, 115, 100, 135, 210, 95, 120, 105,
145, 220, 100, 130, 110],
}
# Criando DataFrame
df_municipios_pr = pd.DataFrame(dados_parana)
# Gerar dados fictícios para localização, idade e endereço
np.random.seed(42)
df_municipios_pr["Latitude"] = np.random.uniform(-25.5, -23.5, size=len(df_municipios_pr))
df_municipios_pr["Longitude"] = np.random.uniform(-54.5, -49.5, size=len(df_municipios_pr))
df_municipios_pr["Idade"] = np.random.randint(60, 101, size=len(df_municipios_pr))
enderecos = [
"Rua das Flores, 123", "Av. Central, 456", "Praça da Liberdade",
"Rua XV de Novembro, 789", "Av. Paraná, 321"
]
df_municipios_pr["Endereço Aproximado"] = np.random.choice(enderecos, size=len(df_municipios_pr))
# Caminho do arquivo CSV
caminho_csv_pr_atualizado = "/mnt/data/fraturas_municipios_pr_atualizado.csv"
# Salvar o arquivo CSV atualizado
df_municipios_pr.to_csv(caminho_csv_pr_atualizado, index=False, encoding="utf-8")
# Retornar o caminho do arquivo atualizado
caminho_csv_pr_atualizado
